#format http://ns.nuke24.net/TEF/Formats/SyntaxV0.3

=namespace tag:nuke24.net,2026-11:togetl:
short-description: terms minted to describe the machinery of TOGETL itself

=type tag:nuke24.net,2026-11:togetl:Document
short-description: a source document that was read by an importer

=type tag:nuke24.net,2026-11:togetl:ParseIssue
short-description: a problem encountered while reading a source document

=type tag:nuke24.net,2026-11:togetl:File
short-description: a file referenced by a source document

=type tag:nuke24.net,2026-11:togetl:Narration
short-description: a narrative note attached to project data

=type tag:nuke24.net,2026-11:togetl:Namespace
short-description: an RDF namespace or ontology

=attribute tag:nuke24.net,2026-11:togetl:sourceUrl
short-description: the canonical URL of a source document

=attribute tag:nuke24.net,2026-11:togetl:format
short-description: the detected or declared source format

=attribute tag:nuke24.net,2026-11:togetl:parserVersion
short-description: version of the parser that read the document

=attribute tag:nuke24.net,2026-11:togetl:hasBom
short-description: whether the source began with a UTF-8 byte order mark

=attribute tag:nuke24.net,2026-11:togetl:document
short-description: links a derived resource to its source document

=attribute tag:nuke24.net,2026-11:togetl:parseIssue
short-description: links a document to one of its parse issues

=attribute tag:nuke24.net,2026-11:togetl:severity
short-description: severity of a parse issue

=attribute tag:nuke24.net,2026-11:togetl:code
short-description: machine-readable code for a parse issue

=attribute tag:nuke24.net,2026-11:togetl:message
short-description: human-readable parse issue message

=attribute tag:nuke24.net,2026-11:togetl:raw
short-description: raw source text associated with a parse issue

=attribute tag:nuke24.net,2026-11:togetl:unmappedEntry
short-description: an entry type that the selected dialect did not map

=attribute tag:nuke24.net,2026-11:togetl:unmappedField
short-description: a header that the selected dialect did not map

=attribute tag:nuke24.net,2026-11:togetl:asWritten
short-description: the original spelling or value before normalization

=attribute tag:nuke24.net,2026-11:togetl:contentType
# TODO: I suspect this should really be 'tef:contentType',
# which actually identifies _the format of the description of the resource_.
# e.g. a piece of wood does not have a content type, but it
# might be described by a text-based resource that does.
short-description: a content type declaration
