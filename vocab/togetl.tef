#format http://ns.nuke24.net/TEF/Formats/SyntaxV0.3

=namespace tag:nuke24.net,2026-11:togetl:
short-description: terms minted to describe the machinery of TOGETL itself

=type tag:nuke24.net,2026-11:togetl:Document
short-description: a source document

=type tag:nuke24.net,2026-11:togetl:DocumentImport
short-description: one import of one source document

=type tag:nuke24.net,2026-11:togetl:ParseIssue
short-description: a problem encountered while reading a source document

=type tag:nuke24.net,2026-11:togetl:File
short-description: a file referenced by a source document

=type tag:nuke24.net,2026-11:togetl:Narration
short-description: a narrative note attached to project data

=type tag:nuke24.net,2026-11:togetl:Namespace
short-description: an RDF namespace or ontology

=type tag:nuke24.net,2026-11:togetl:OrgHeading
short-description: a heading node from an Org document outline

=type tag:nuke24.net,2026-11:togetl:OrgProperty
short-description: one property from an Org property drawer

=type tag:nuke24.net,2026-11:togetl:OrgPlanning
short-description: a planning keyword and timestamp on an Org heading

=attribute tag:nuke24.net,2026-11:togetl:sourceDocument
short-description: links a document import to its source document

=attribute tag:nuke24.net,2026-11:togetl:sourceUrl
short-description: the canonical URL of a source document

=attribute tag:nuke24.net,2026-11:togetl:format
short-description: the detected or declared source format

=attribute tag:nuke24.net,2026-11:togetl:parserVersion
short-description: version of the parser used by a document import

=attribute tag:nuke24.net,2026-11:togetl:hasBom
short-description: whether a document import observed a UTF-8 byte order mark

=attribute tag:nuke24.net,2026-11:togetl:document
short-description: links a derived resource to its source document

=attribute tag:nuke24.net,2026-11:togetl:parseIssue
short-description: links a document import to one of its parse issues

=attribute tag:nuke24.net,2026-11:togetl:severity
short-description: severity of a parse issue

=attribute tag:nuke24.net,2026-11:togetl:code
short-description: machine-readable code for a parse issue

=attribute tag:nuke24.net,2026-11:togetl:message
short-description: human-readable parse issue message

=attribute tag:nuke24.net,2026-11:togetl:raw
short-description: raw source text associated with a parse issue

=attribute tag:nuke24.net,2026-11:togetl:unmappedEntry
short-description: an entry type that the selected dialect did not map

=attribute tag:nuke24.net,2026-11:togetl:unmappedField
short-description: a header that the selected dialect did not map

=attribute tag:nuke24.net,2026-11:togetl:asWritten
short-description: the original spelling or value before normalization

=attribute tag:nuke24.net,2026-11:togetl:contentType
# TODO: I suspect this should really be 'tef:contentType',
# which actually identifies _the format of the description of the resource_.
# e.g. a piece of wood does not have a content type, but it
# might be described by a text-based resource that does.
short-description: a content type declaration

=attribute tag:nuke24.net,2026-11:togetl:orgHeading
short-description: links a source document to one of its Org heading resources

=attribute tag:nuke24.net,2026-11:togetl:outlineParent
short-description: parent heading in an Org outline tree

=attribute tag:nuke24.net,2026-11:togetl:outlinePath
short-description: human-readable heading path from root to this heading

=attribute tag:nuke24.net,2026-11:togetl:outlineLevel
short-description: heading depth in the Org outline

=attribute tag:nuke24.net,2026-11:togetl:outlineIndex
short-description: zero-based heading ordinal in source order

=attribute tag:nuke24.net,2026-11:togetl:customId
short-description: CUSTOM_ID property declared on an Org heading

=attribute tag:nuke24.net,2026-11:togetl:orgTodoKeyword
short-description: TODO-style keyword at the start of an Org heading

=attribute tag:nuke24.net,2026-11:togetl:orgPriority
short-description: priority cookie declared on an Org heading

=attribute tag:nuke24.net,2026-11:togetl:orgProperty
short-description: links an Org heading to one of its drawer properties

=attribute tag:nuke24.net,2026-11:togetl:orgPropertyName
short-description: key of an Org drawer property

=attribute tag:nuke24.net,2026-11:togetl:orgPropertyValue
short-description: value of an Org drawer property

=attribute tag:nuke24.net,2026-11:togetl:orgPlanning
short-description: links an Org heading to a planning entry

=attribute tag:nuke24.net,2026-11:togetl:orgPlanningKeyword
short-description: SCHEDULED, DEADLINE, or CLOSED planning keyword

=attribute tag:nuke24.net,2026-11:togetl:orgTimestamp
short-description: timestamp token associated with an Org heading

=attribute tag:nuke24.net,2026-11:togetl:orgTimestampActive
short-description: whether an Org timestamp uses the active angle-bracket form

=attribute tag:nuke24.net,2026-11:togetl:orgCheckboxState
short-description: parsed checkbox state from heading content

=attribute tag:nuke24.net,2026-11:togetl:orgLink
short-description: links an Org heading to a parsed link node

=attribute tag:nuke24.net,2026-11:togetl:orgLinkTarget
short-description: target string of an Org link node

=attribute tag:nuke24.net,2026-11:togetl:orgLinkLabel
short-description: optional display label of an Org link node
