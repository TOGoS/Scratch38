=part p2004
short-description: 1+1/2-inch long x 1-inch-deep prototype snap-to-Minirail conduit
stl-file: p2004.stl	urn:bitprint:CLQFGSJOWGSGA67C6NDVNWHE5SKPHOWB.FWPXKKOQ56AVEZTZFCGJ3BP5LERX6DOHN6RGUHQ
