{
	"imports": {
		"@std/assert": "jsr:@std/assert@^1",
		"@std/path": "jsr:@std/path@^1"
	},
	"fmt": {
		"useTabs": true,
		"newLineKind": "lf",
		"exclude": ["*.md"]
	},
	"tasks": {
		"fmt": "deno fmt && deno run --allow-read --allow-write tools/fix-blank-lines.ts src tools stlmod",
		"test": "deno test --allow-read --allow-write --allow-run --allow-net=127.0.0.1,example.com",
		"check": "deno check stlmod src tools"
	}
}
